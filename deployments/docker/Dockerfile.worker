# =============================================================================
# Background Worker Dockerfile — Multi-stage build
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1: Base Python image with common dependencies
# ---------------------------------------------------------------------------
FROM python:3.13-slim AS base

ENV PYTHONFAULTHANDLER=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN groupadd --system --gid 1000 legal && \
    useradd --system --uid 1000 --gid legal --create-home legal

WORKDIR /app

# ---------------------------------------------------------------------------
# Stage 2: Builder — install compiled dependencies
# ---------------------------------------------------------------------------
FROM base AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .

RUN pip install --upgrade pip setuptools wheel && \
    pip wheel --wheel-dir=/wheels -e ".[worker]"

# ---------------------------------------------------------------------------
# Stage 3: Production runtime
# ---------------------------------------------------------------------------
FROM base AS production

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /wheels /wheels
RUN pip install --no-index --find-links=/wheels /wheels/*.whl && \
    rm -rf /wheels

COPY app/ /app/app/

RUN mkdir -p /app/uploads /app/exports /models && \
    chown -R legal:legal /app /models

USER legal

# Placeholder — will be replaced with Celery worker command in later modules
CMD ["python", "-m", "app.workers.run"]

# ---------------------------------------------------------------------------
# Stage 4: Development runtime
# ---------------------------------------------------------------------------
FROM production AS development

USER root

RUN pip install -e ".[dev]"

USER legal

CMD ["python", "-m", "app.workers.run"]
