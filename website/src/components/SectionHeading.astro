---
/**
 * Consistent section rhythm: kicker + H2 + optional lede.
 */
interface Props {
  kicker?: string;
  title: string;
  lede?: string;
  id?: string;
  align?: "left" | "center";
}

const { kicker, title, lede, id, align = "left" } = Astro.props;
---

<div
  class:list={[
    "max-w-2xl",
    align === "center" && "mx-auto text-center",
  ]}
>
  {kicker && <p class="kicker mb-3">{kicker}</p>}
  <h2 id={id} class="font-display text-h2 text-ink">{title}</h2>
  {lede && <p class="lede mt-4 measure">{lede}</p>}
</div>
