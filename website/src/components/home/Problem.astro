---
import SectionHeading from "../SectionHeading.astro";
import en from "../../content/strings/en.json";
import de from "../../content/strings/de.json";

interface Props {
  lang?: "en" | "de";
}

const { lang = "en" } = Astro.props;
const t = lang === "de" ? de.problem : en.problem;
---

<section id="problem" class="section">
  <div class="container-page">
    <SectionHeading kicker={t.kicker} title={t.title} lede={t.lede} />

    <ul class="mt-12 grid gap-6 md:grid-cols-3">
      {
        t.cards.map((card) => (
          <li class="card p-6">
            <h3 class="text-lg font-semibold text-ink">{card.title}</h3>
            <p class="mt-3 text-muted">{card.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
