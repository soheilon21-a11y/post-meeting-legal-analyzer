---
import SectionHeading from "../SectionHeading.astro";
import { githubIssuesUrl, githubDiscussionsUrl } from "../../config";
import en from "../../content/strings/en.json";
import de from "../../content/strings/de.json";

interface Props {
  lang?: "en" | "de";
}

const { lang = "en" } = Astro.props;
const t = lang === "de" ? de.contact : en.contact;
---

<section id="contact" class="section">
  <div class="container-page">
    <SectionHeading kicker={t.kicker} title={t.title} lede={t.body} />

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={githubIssuesUrl}
        rel="noopener"
        class="rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-white no-underline hover:bg-accent-dark"
      >
        {t.issuesCta}
      </a>
      <a
        href={githubDiscussionsUrl}
        rel="noopener"
        class="rounded-lg border border-border px-5 py-3 text-sm font-semibold text-ink no-underline hover:border-accent hover:text-accent"
      >
        {t.discussionsCta}
      </a>
    </div>
  </div>
</section>
