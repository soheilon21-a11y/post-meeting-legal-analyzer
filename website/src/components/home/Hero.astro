---
/**
 * Hero — two-column on desktop, stacked on mobile.
 * Reused by both the EN landing page and the German stub page.
 */
import { githubUrl, href, testCount } from "../../config";
import en from "../../content/strings/en.json";
import de from "../../content/strings/de.json";
import HeroArtifact from "./HeroArtifact.astro";
import TrustBar from "./TrustBar.astro";

interface Props {
  lang?: "en" | "de";
}

const { lang = "en" } = Astro.props;
const t = lang === "de" ? de.hero : en.hero;

const trustItems =
  lang === "de"
    ? [
        de.hero.trustBar.local,
        de.hero.trustBar.license,
        de.hero.trustBar.tests.replace("{count}", String(testCount)),
      ]
    : [
        en.trustBar.local,
        en.trustBar.license,
        en.trustBar.tests.replace("{count}", String(testCount)),
      ];
---

<section class="section">
  <div class="container-page grid items-center gap-12 lg:grid-cols-2">
    <div>
      <p class="kicker">{t.kicker}</p>

      <h1 class="mt-4 font-display text-ink">
        <span class="block text-display">{t.titleBrand}</span>
        <span class="mt-2 block text-xl font-normal text-muted">
          {t.titleRest}
        </span>
      </h1>

      <p class="mt-6 font-display text-h2 text-accent">{t.tagline}</p>

      <p class="mt-4 measure text-lg text-muted">{t.subheadline}</p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={githubUrl}
          rel="noopener"
          class="rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-white no-underline hover:bg-accent-dark"
        >
          {t.ctaPrimary}
        </a>
        <a
          href={href("/#how-it-works")}
          class="rounded-lg border border-border px-5 py-3 text-sm font-semibold text-ink no-underline hover:border-accent hover:text-accent"
        >
          {t.ctaSecondary}
        </a>
      </div>

      <div class="mt-8">
        <TrustBar items={trustItems} />
      </div>
    </div>

    <div class="lg:justify-self-end">
      <HeroArtifact />
    </div>
  </div>
</section>
