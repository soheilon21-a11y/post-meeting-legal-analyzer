---
import SectionHeading from "../SectionHeading.astro";
import en from "../../content/strings/en.json";
import de from "../../content/strings/de.json";

interface Props {
  lang?: "en" | "de";
}

const { lang = "en" } = Astro.props;
const t = lang === "de" ? de.privacy : en.privacy;
---

<section id="privacy" class="section">
  <div class="container-page">
    <SectionHeading kicker={t.kicker} title={t.title} />

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      <div class="card p-6">
        <h3 class="text-lg font-semibold text-ink">{t.gdpr.title}</h3>
        <p class="mt-3 text-muted">{t.gdpr.body}</p>
      </div>
      <div class="card p-6">
        <h3 class="text-lg font-semibold text-ink">{t.aiAct.title}</h3>
        <p class="mt-3 text-muted">{t.aiAct.body}</p>
      </div>
    </div>

    <p class="mt-6 text-sm text-muted">{t.notLegalAdvice}</p>

    <!-- Boxed site-privacy statement. -->
    <div class="mt-8 rounded-xl border border-accent bg-accent-soft p-6">
      <h3 class="text-lg font-semibold text-ink">{t.site.title}</h3>
      <ul class="mt-4 space-y-2 text-sm text-ink">
        {
          t.site.lines.map((line) => (
            <li class="flex gap-2">
              <span aria-hidden="true" class="text-accent">•</span>
              <span>{line}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
