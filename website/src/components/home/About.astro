---
import SectionHeading from "../SectionHeading.astro";
import en from "../../content/strings/en.json";
import de from "../../content/strings/de.json";

interface Props {
  lang?: "en" | "de";
}

const { lang = "en" } = Astro.props;
const t = lang === "de" ? de.about : en.about;
---

<section id="about" class="section">
  <div class="container-page">
    <SectionHeading kicker={t.kicker} title={t.title} />

    <p class="mt-8 measure text-lg leading-relaxed text-ink">
      {t.bioPlaceholder}
    </p>

    <p class="mt-6 measure text-lg leading-relaxed text-ink">
      {t.brandStory}
    </p>

    <!-- Dedication, set quietly in serif italic after generous whitespace. -->
    <p class="mt-16 font-display text-xl italic text-muted">
      {t.dedication}
    </p>
  </div>
</section>
