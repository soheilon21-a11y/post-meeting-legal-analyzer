---
/**
 * Original inline-SVG icon set. Every icon is decorative by default
 * (`aria-hidden`), so the surrounding text or link label carries the meaning.
 * Icons use `currentColor` and scale with the `size` prop.
 */
interface Props {
  /**
   * Supported names: shield, lock, doc, quote, scale, audit-chain, pdf,
   * check, arrow, github, cloud-off, menu, close. Unknown names render empty.
   */
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className = "" } = Astro.props;

const paths: Record<string, string[]> = {
  shield: [
    "M12 3l7 3v5c0 4.6-3 8.2-7 10-4-1.8-7-5.4-7-10V6l7-3z",
    "M9 12l2 2 4-4",
  ],
  lock: [
    "M6 11h12a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1z",
    "M8 11V8a4 4 0 0 1 8 0v3",
  ],
  doc: [
    "M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5z",
    "M14 3v5h5",
    "M9 13h6",
    "M9 17h6",
  ],
  quote: [
    "M9.5 6C7 6 5 8 5 10.5V18h6v-6H8.5c0-1.5 1-2.5 2.5-2.5V6z",
    "M17.5 6C15 6 13 8 13 10.5V18h6v-6h-2.5c0-1.5 1-2.5 2.5-2.5V6z",
  ],
  scale: [
    "M12 3v18",
    "M7 21h10",
    "M5 7h14",
    "M5 7 2 13a3 3 0 0 0 6 0L5 7Z",
    "M19 7 22 13a3 3 0 0 1-6 0L19 7Z",
  ],
  "audit-chain": [
    "M9.5 14.5l5-5",
    "M7.5 12.5 6 14a3.5 3.5 0 0 0 5 5l1.5-1.5",
    "M16.5 11.5 18 10a3.5 3.5 0 0 0-5-5l-1.5 1.5",
  ],
  pdf: [
    "M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5z",
    "M14 3v5h5",
    "M9 14h6",
    "M9 17h4",
  ],
  check: ["M20 6 9 17l-5-5"],
  arrow: ["M5 12h14", "M13 6l6 6-6 6"],
  "cloud-off": [
    "M7 18a4 4 0 0 1-.9-7.9A5.5 5.5 0 0 1 16.5 8.5 3.5 3.5 0 0 1 17 18H7z",
    "M3 3l18 18",
  ],
  menu: ["M4 7h16", "M4 12h16", "M4 17h16"],
  close: ["M6 6l12 12", "M18 6L6 18"],
};

// GitHub mark is a filled silhouette rather than a stroked line icon.
const githubPath =
  "M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.8 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.5-2.7 5.5-5.3 5.8.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z";

const filled = name === "github";
---

<svg
  class={className || undefined}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={filled ? "currentColor" : "none"}
  stroke={filled ? "none" : "currentColor"}
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    filled ? (
      <path d={githubPath} />
    ) : (
      (paths[name] ?? []).map((d) => <path d={d} />)
    )
  }
</svg>
