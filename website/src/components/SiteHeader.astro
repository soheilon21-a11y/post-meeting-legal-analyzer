---
/**
 * Site header: wordmark + seal, primary anchor nav, GitHub link, EN/DE toggle.
 * Non-sticky (zero CLS risk). On small screens the nav collapses into a native
 * <details>/<summary> disclosure — keyboard-accessible without any JavaScript.
 */
import { name, githubUrl, href } from "../config";
import Icon from "./Icon.astro";
import LangToggle from "./LangToggle.astro";
import en from "../content/strings/en.json";
import de from "../content/strings/de.json";

interface Props {
  lang?: "en" | "de";
}

const { lang = "en" } = Astro.props;
// German nav hrefs point at the /de/ page anchors; English ones at "/".
const nav = lang === "de" ? de.nav : en.nav;
---

<header class="border-b border-border bg-bg">
  <div class="container-page flex items-center justify-between gap-4 py-4">
    <a
      href={href("/")}
      class="flex items-center gap-2.5 text-ink no-underline"
      aria-label={`${name} — home`}
    >
      <svg
        width="30"
        height="30"
        viewBox="0 0 32 32"
        aria-hidden="true"
        focusable="false"
        class="text-accent"
      >
        <circle
          cx="16"
          cy="16"
          r="14.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"></circle>
        <path
          d="M9.5 22V10l6.5 8 6.5-8v12"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <span class="font-display text-2xl font-semibold tracking-tight"
        >{name}</span
      >
    </a>

    <nav class="hidden lg:block" aria-label="Primary">
      <ul class="flex items-center gap-6 text-sm">
        {
          nav.map((item) => (
            <li>
              <a
                href={href(item.href)}
                class="text-muted no-underline hover:text-accent"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-4">
      <a
        href={githubUrl}
        rel="noopener"
        class="text-ink hover:text-accent"
        aria-label="Karnam on GitHub"
      >
        <Icon name="github" size={22} />
      </a>

      <LangToggle lang={lang} />

      <details class="relative lg:hidden">
        <summary
          class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-lg border border-border text-ink [&::-webkit-details-marker]:hidden"
          aria-label="Open menu"
        >
          <Icon name="menu" size={22} />
        </summary>
        <nav class="card absolute right-0 z-20 mt-2 w-56 p-3" aria-label="Mobile">
          <ul class="flex flex-col">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={href(item.href)}
                    class="block rounded-md px-3 py-2 text-sm text-ink no-underline hover:bg-accent-soft"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
