---
/**
 * Site footer: dark band with four columns — brand, explore anchors, follow
 * (LinkedIn + GitHub), legal — then a bottom trust row. The trust claim ships
 * only because the zero-external-request audit passes on the built output.
 */
import { name, githubUrl, githubLicenseUrl, href } from "../config";
import en from "../content/strings/en.json";
import de from "../content/strings/de.json";

interface Props {
  lang?: "en" | "de";
}

const { lang = "en" } = Astro.props;
const t = lang === "de" ? de.footer : en.footer;
const tagline = lang === "de" ? de.hero.tagline : en.hero.tagline;

const linkedinUrl = "https://www.linkedin.com/in/soheil-onsori/";

const exploreLinks = [
  { label: t.problemLabel, href: lang === "de" ? "/de/#problem" : "/#problem" },
  { label: t.roadmapLabel, href: lang === "de" ? "/de/#open-source" : "/#open-source" },
  { label: t.aboutLabel, href: lang === "de" ? "/de/#about" : "/#about" },
  { label: t.contactLabel, href: lang === "de" ? "/de/#contact" : "/#contact" },
];

const linkClass = "text-footer-muted no-underline hover:text-white";
---

<footer class="bg-footer-bg text-footer-text">
  <div class="container-page py-14">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="sm:col-span-2 lg:col-span-1">
        <a
          href={href("/")}
          class="flex items-center gap-2.5 text-footer-text no-underline"
          aria-label={`${name} — home`}
        >
          <svg
            width="30"
            height="30"
            viewBox="0 0 32 32"
            aria-hidden="true"
            focusable="false"
            class="text-footer-text"
          >
            <circle
              cx="16"
              cy="16"
              r="14.5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"></circle>
            <path
              d="M9.5 22V10l6.5 8 6.5-8v12"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <span class="font-display text-2xl font-semibold tracking-tight"
            >{name}</span
          >
        </a>
        <p class="mt-4 font-display text-lg text-white">{tagline}</p>
        <p class="mt-2 text-sm text-footer-muted">{t.brandNote}</p>
      </div>

      <nav aria-label={t.exploreTitle}>
        <h2 class="text-sm font-semibold text-white">{t.exploreTitle}</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {
            exploreLinks.map((link) => (
              <li>
                <a class={linkClass} href={href(link.href)}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label={t.followTitle}>
        <h2 class="text-sm font-semibold text-white">{t.followTitle}</h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a class={linkClass} href={linkedinUrl} rel="noopener">
              LinkedIn
            </a>
          </li>
          <li>
            <a class={linkClass} href={githubUrl} rel="noopener">
              GitHub
            </a>
          </li>
        </ul>
      </nav>

      <nav aria-label={t.legalTitle}>
        <h2 class="text-sm font-semibold text-white">{t.legalTitle}</h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a class={linkClass} href={href("/impressum/")}>
              {t.impressumLabel}
            </a>
          </li>
          <li>
            <a class={linkClass} href={href("/datenschutz/")}>
              {t.datenschutzLabel}
            </a>
          </li>
          <li>
            <a class={linkClass} href={githubLicenseUrl} rel="noopener">
              {t.mitLicenseLabel}
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <div
      class="mt-12 flex flex-col gap-2 border-t border-footer-muted/30 pt-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-sm text-footer-muted">© 2026 Soheil Onsori.</p>
      <p class="text-sm text-footer-muted">{t.trust}</p>
    </div>
  </div>
</footer>
