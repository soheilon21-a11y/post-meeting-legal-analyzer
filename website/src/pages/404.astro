---
import BaseLayout from "../layouts/BaseLayout.astro";
import { href } from "../config";
import en from "../content/strings/en.json";

const t = en.notFound;
---

<BaseLayout
  title={en.meta.notFoundTitle}
  description={en.meta.notFoundDescription}
  lang="en"
>
  <section class="section">
    <div class="container-page text-center">
      <p class="font-mono text-sm font-semibold text-accent">404</p>
      <h1 class="mt-4 font-display text-h2 text-ink">{t.title}</h1>
      <p class="mt-4 text-muted">{t.body}</p>
      <a
        href={href("/")}
        class="mt-8 inline-block rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-white no-underline hover:bg-accent-dark"
      >
        {t.homeCta}
      </a>
    </div>
  </section>
</BaseLayout>
